# Zero-Key Policy: No static API keys are stored or required by this project.
# LLM scriptwriting uses either your human-authenticated `agy` subscription CLI
# or a local zero-key Ollama instance.

# Optional: point to an external reports directory (e.g., ../yt-auto-cut/output)
# REPORTS_DIR=../yt-auto-cut/output

# Optional: custom episodes storage path
# VIBEPODCAST_EPISODES_DIR=./episodes

# Optional: remote VibeVoice GPU server URL
# VIBEVOICE_REMOTE_URL=http://localhost:9000

# Optional: local zero-key Ollama endpoint and model
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:14b

# Optional: Cloudflare Tunnel / reverse-proxy public HTTPS origin for RSS feed & CORS
# VIBEPODCAST_PUBLIC_URL=https://podcast.example.com
# VIBEPODCAST_ALLOWED_ORIGINS=https://podcast.example.com
# VIBEPODCAST_TOKEN=replace-with-long-random-secret-if-pinning-across-hosts
# VIBEPODCAST_LISTEN_TOKEN=replace-with-read-only-listener-secret-for-friends
